package humpback

import (
	"workshop/cmd/themes/internal/layout"
	"workshop/cmd/themes/internal/themeutil"
	"workshop/internal/domain/sighting"
)

// Page is the console: a metric strip, a grid of panels, a picture wall
// and the ledger of every record behind them.
templ Page(p Props) {
	@layout.Base(layout.BaseProps{
		Title:       "Humpback Console — Sightings",
		Description: "Every recorded humpback whale sighting, charted, mapped and listed.",
		Class:       "console",
		Fonts:       "https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@300;400;500;600;700&display=swap",
		Stylesheet:  "/assets/css/humpback.css",
		Skip:        layout.SkipLink{Target: "ledger", Label: "Skip to the ledger"},
		Header:      bar(),
		Footer:      foot(p),
		Map:         &layout.MapProps{Points: p.Points},
	}) {
		@banner(p)
		@metrics(p)
		@panels(p)
		@wall(p)
		@ledger(p)
	}
}

templ bar() {
	<header class="bar">
		<a class="bar__brand" href="/humpback">
			<span class="bar__dot" aria-hidden="true"></span>
			<span>Humpback Console</span>
		</a>
		<nav class="bar__nav" aria-label="Themes">
			for _, l := range layout.Nav {
				<a href={ templ.URL(l.Path) } aria-current={ l.Current("/humpback") }>{ l.Title }</a>
			}
		</nav>
	</header>
}

// banner names the species the console is filtered to.
templ banner(p Props) {
	<section class="banner">
		<div>
			<p class="banner__eyebrow">Megaptera novaeangliae</p>
			<h1 class="banner__title">Humpback whale</h1>
			<p class="banner__sub">
				Every humpback record in the database, across { count(p.Summary.Countries) } countries
				and { themeutil.Span(p.Summary) }.
			</p>
		</div>
		<p class="banner__stamp">
			<span>Last record</span>
			if p.Summary.Sightings > 0 {
				<strong>{ p.Summary.Latest.Format("2 Jan 2006") }</strong>
				<span>{ themeutil.Since(p.Summary.Latest, p.Now) }</span>
			} else {
				<strong>&mdash;</strong>
			}
		</p>
	</section>
}

templ metrics(p Props) {
	<section class="metrics" aria-label="Headline figures">
		@metric("Records", count(p.Summary.Sightings))
		@metric("Countries", count(p.Summary.Countries))
		@metric("Individuals", count(p.Summary.Individuals))
		@metric("Photographs", count(p.Summary.Media))
		@metric("Observers", count(p.Summary.Recorders))
		@metric("Span", themeutil.Span(p.Summary))
	</section>
}

templ metric(label, value string) {
	<div class="metric">
		<span>{ label }</span>
		<strong>{ value }</strong>
	</div>
}

// panels is the bento: the map beside the charts that describe it.
templ panels(p Props) {
	<section class="panels">
		<article class="panel panel--map">
			<header class="panel__head">
				<h2>Distribution</h2>
				<p>{ count(len(p.Points)) } located records</p>
			</header>
			if len(p.Points) > 0 {
				<div
					class="panel__map"
					data-sightings-map
					data-points="map-points"
					data-marker-fill="#22d3ee"
					data-marker-stroke="#083344"
					data-marker-radius="4"
					data-max-zoom="5"
					role="region"
					aria-label="Map of humpback whale records worldwide. Every record is listed in the ledger below."
					tabindex="0"
				></div>
			} else {
				<p class="panel__empty">No located records to plot.</p>
			}
		</article>
		<article class="panel panel--chart">
			<header class="panel__head">
				<h2>Records per year</h2>
				<p>Empty years kept</p>
			</header>
			if len(p.Years) == 0 {
				<p class="panel__empty">No records yet.</p>
			} else {
				<div class="chart">
					<ul class="chart__plot">
						for _, y := range p.Years {
							<li class="chart__col">
								<span class="chart__bar" style={ height(y.Percent) } aria-hidden="true"></span>
								<span class="chart__tip">{ count(y.Count) }</span>
								<span class="visually-hidden">{ count(y.Year) }: { count(y.Count) } records</span>
								<span class="chart__year" aria-hidden="true">{ shortYear(y.Year) }</span>
							</li>
						}
					</ul>
				</div>
			}
		</article>
		@board("Countries", p.Countries, p.Summary.Sightings)
		@board("Observers", p.Observers, p.Summary.Sightings)
		@board("Basis of record", p.Basis, p.Summary.Sightings)
	</section>
}

templ board(title string, rows []sighting.Tally, total int) {
	<article class="panel panel--board">
		<header class="panel__head">
			<h2>{ title }</h2>
		</header>
		if len(rows) == 0 {
			<p class="panel__empty">Nothing recorded.</p>
		} else {
			<ul class="board">
				for _, r := range rows {
					<li class="board__row">
						<span class="board__name">{ r.Name }</span>
						<span class="board__track" aria-hidden="true">
							<span class="board__fill" style={ width(rows, r.Count) }></span>
						</span>
						<span class="board__num">{ count(r.Count) }</span>
						<span class="board__pct">{ share(r.Count, total) }</span>
					</li>
				}
			</ul>
		}
	</article>
}

// wall is the picture grid, capped so the page stays light.
templ wall(p Props) {
	if len(p.Gallery) > 0 {
		<section class="wall" aria-labelledby="wall-title">
			<header class="section__head">
				<h2 id="wall-title">Latest sightings</h2>
				<p>
					Showing { count(len(p.Gallery)) } of { count(p.Summary.Sightings) }. All
					{ count(p.Summary.Sightings) } are in the ledger below.
				</p>
			</header>
			<ul class="wall__grid">
				for _, s := range p.Gallery {
					<li class="tile">
						<a href={ templ.URL("#" + themeutil.Anchor(s)) } class="tile__link">
							if url := themeutil.Thumbnail(s); url != "" {
								<img src={ url } alt={ themeutil.AltText(s) } loading="lazy" decoding="async"/>
							} else {
								<span class="tile__blank" aria-hidden="true"></span>
							}
							<span class="tile__meta">
								<strong>{ themeutil.Locale(s.Location) }</strong>
								<span>{ s.HappenedAt.Format("2 Jan 2006") }</span>
							</span>
						</a>
					</li>
				}
			</ul>
		</section>
	}
}

// ledger lists every record as text, which is cheap enough to render in
// full and is the accessible equivalent of the map above.
templ ledger(p Props) {
	<section class="ledger" id="ledger" aria-labelledby="ledger-title">
		<header class="section__head">
			<h2 id="ledger-title">Ledger</h2>
			<p>All { count(p.Summary.Sightings) } records, newest first.</p>
		</header>
		if len(p.Sightings) == 0 {
			<p class="panel__empty">
				No humpback records yet. Run <code>workshop sightings ingest</code> to fetch some.
			</p>
		} else {
			<div class="ledger__scroll">
				<table class="ledger__table">
					<caption class="visually-hidden">
						Every humpback whale record, newest first, with date, place, position, count and observer.
					</caption>
					<thead>
						<tr>
							<th scope="col">Date</th>
							<th scope="col">Country</th>
							<th scope="col">Locality</th>
							<th scope="col">Position</th>
							<th scope="col" class="num">Seen</th>
							<th scope="col">Observer</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range p.Sightings {
							<tr id={ themeutil.Anchor(s) }>
								<td class="num">
									<time datetime={ s.HappenedAt.Format("2006-01-02") }>
										{ s.HappenedAt.Format("2 Jan 2006") }
									</time>
								</td>
								<td>{ s.Location.Country }</td>
								<td>{ themeutil.Locale(s.Location) }</td>
								<td class="num">{ themeutil.Coordinates(s.Location) }</td>
								<td class="num">
									if s.IndividualCount != nil {
										{ count(*s.IndividualCount) }
									} else {
										<span class="dim">&mdash;</span>
									}
								</td>
								<td class="ledger__observer">{ themeutil.Recorder(s) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ foot(p Props) {
	<footer class="foot">
		<p>Occurrence data from GBIF. Basemap &copy; OpenStreetMap contributors.</p>
		<p>Built { p.Now.Format("2 January 2006, 15:04") }.</p>
	</footer>
}
